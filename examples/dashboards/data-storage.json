{
  "annotations": {
    "list": []
  },
  "editable": true,
  "links": [
    {
      "includeTimeRange": false,
      "keepTime": false,
      "title": "Start Here",
      "type": "link",
      "url": "/d/xlayer-start-here"
    },
    {
      "includeTimeRange": true,
      "keepTime": true,
      "title": "Run Overview",
      "type": "link",
      "url": "/d/telemetry-overview?${cluster:queryparam}&${node:queryparam}&${run_id:queryparam}"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Disk read and write throughput",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_disk_read_bytes_total{job=\"telemetry\",cluster=~\"$cluster\",instance=~\"$node\",device=~\"$device\"}[$__rate_interval])",
          "legendFormat": "{{cluster}}/{{instance}} {{device}} read"
        },
        {
          "refId": "B",
          "expr": "rate(node_disk_written_bytes_total{job=\"telemetry\",cluster=~\"$cluster\",instance=~\"$node\",device=~\"$device\"}[$__rate_interval])",
          "legendFormat": "{{cluster}}/{{instance}} {{device}} write"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "description": "선택한 Node·Device의 read/write bytes/s입니다. Run이나 sandbox의 I/O 양으로 자동 귀속하지 않습니다."
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Disk IOPS",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_disk_reads_completed_total{job=\"telemetry\",cluster=~\"$cluster\",instance=~\"$node\",device=~\"$device\"}[$__rate_interval])",
          "legendFormat": "{{cluster}}/{{instance}} {{device}} read"
        },
        {
          "refId": "B",
          "expr": "rate(node_disk_writes_completed_total{job=\"telemetry\",cluster=~\"$cluster\",instance=~\"$node\",device=~\"$device\"}[$__rate_interval])",
          "legendFormat": "{{cluster}}/{{instance}} {{device}} write"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "iops",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "description": "선택한 Node·Device의 read/write operations/s입니다. Device 전체 counter이며 request size나 metadata latency를 직접 보여 주지는 않습니다."
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Disk I/O busy time",
      "description": "I/O가 진행 중이던 wall-time 비율입니다. Latency percentile이 아니며 p99와 동일하게 해석하지 않습니다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_disk_io_time_seconds_total{job=\"telemetry\",cluster=~\"$cluster\",instance=~\"$node\",device=~\"$device\"}[$__rate_interval])",
          "legendFormat": "{{cluster}}/{{instance}} {{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Filesystem used",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - node_filesystem_avail_bytes{job=\"telemetry\",cluster=~\"$cluster\",instance=~\"$node\",mountpoint=~\"$mount\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{job=\"telemetry\",cluster=~\"$cluster\",instance=~\"$node\",mountpoint=~\"$mount\",fstype!~\"tmpfs|overlay\"}",
          "legendFormat": "{{cluster}}/{{instance}} {{mountpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "description": "선택한 Mount의 filesystem 사용 비율입니다. Mount 용량과 Device I/O는 서로 다른 관측 범위입니다."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Filesystem free space",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_filesystem_avail_bytes{job=\"telemetry\",cluster=~\"$cluster\",instance=~\"$node\",mountpoint=~\"$mount\",fstype!~\"tmpfs|overlay\"}",
          "legendFormat": "{{cluster}}/{{instance}} {{mountpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "description": "선택한 Mount의 filesystem 여유 공간입니다. 3FS FUSE mount를 골라도 local device I/O가 3FS service latency로 바뀌지는 않습니다."
    },
    {
      "id": 6,
      "type": "text",
      "title": "Data path and storage topology",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "options": {
        "mode": "markdown",
        "content": "<span style=\"font-size:16px;line-height:1.65\">**Local device와 remote storage 구분**</span>\n\n- <span style=\"font-size:16px;line-height:1.65\">Disk·filesystem 값은 선택한 node 전체이며 Run별로 분리되지 않습니다.</span>\n- <span style=\"font-size:16px;line-height:1.65\">Dataset·checkpoint I/O attribution에는 workload 계측이 필요합니다.</span>\n- <span style=\"font-size:16px;line-height:1.65\">Topology는 명시적으로 제공한 component·edge 관계입니다. 3FS service latency는 Bottleneck Summary의 ClickHouse evidence에서 확인합니다.</span>\n- <span style=\"font-size:16px;line-height:1.65\">SSD health는 아래 SMART 행을 펼칩니다. Exporter가 없으면 N/A입니다.</span>"
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Storage topology components",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (cluster, kind, component, role) (telemetry_topology_component_info{job=\"telemetry\",cluster=~\"$cluster\",kind=\"storage\"})",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "lg",
        "enablePagination": true
      },
      "description": "선택한 Cluster의 명시적으로 제공된 component입니다. Node·Run 필터와 독립적으로 표시합니다."
    },
    {
      "id": 8,
      "type": "table",
      "title": "Storage topology matrix",
      "description": "선택한 Cluster의 명시적으로 제공된 edge입니다. 측정 traffic이 아니며 Node·Run 필터는 적용되지 않습니다. Cluster를 포함한 endpoint identity로 충돌을 방지합니다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 30
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_join(label_join(max by (cluster, source, destination) (telemetry_topology_edge_info{job=\"telemetry\",cluster=~\"$cluster\",kind=\"storage\"}), \"source_key\", \"/\", \"cluster\", \"source\"), \"destination_key\", \"/\", \"cluster\", \"destination\")",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "lg",
        "enablePagination": true
      },
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "destination_key",
            "rowField": "source_key",
            "valueField": "Value"
          }
        }
      ]
    },
    {
      "id": 90,
      "type": "text",
      "title": "Device / mount / SSD selection",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "<span style=\"font-size:16px;line-height:1.65\">**Local I/O:** Node · Device · Mount를 선택합니다. **SSD health:** 접힌 SMART 행에서 Storage node · SSD를 확인합니다.</span>\n\n<span style=\"font-size:16px;line-height:1.65\">Disk busy는 latency p99가 아닙니다. 3FS service latency는 diagnostics의 ClickHouse evidence로 확인하며 local sandbox NVMe와 구분합니다.</span>"
      }
    },
    {
      "id": 91,
      "type": "row",
      "title": "SSD health / SMART (optional)",
      "description": "SMART exporter를 연결한 경우 펼칩니다. Storage system · Storage node · SSD 필터는 위 Node 필터와 별도입니다.",
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "panels": [
        {
          "id": 9,
          "type": "stat",
          "title": "SSDs with critical warnings",
          "gridPos": {
            "h": 4,
            "w": 6,
            "x": 0,
            "y": 39
          },
          "datasource": {
            "type": "prometheus",
            "uid": "telemetry-prometheus"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum(smartctl_device_critical_warning{job=\"storage-smart\",cluster=~\"$cluster\",storage_system=~\"$storage_system\",instance=~\"$storage_node\",device=~\"$ssd\"} != bool 0)",
              "instant": true
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "noValue": "N/A",
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green"
                  },
                  {
                    "color": "red",
                    "value": 1
                  }
                ]
              },
              "mappings": [
                {
                  "type": "special",
                  "options": {
                    "match": "null",
                    "result": {
                      "text": "N/A",
                      "color": "#8e8e8e"
                    }
                  }
                }
              ]
            },
            "overrides": []
          },
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "values": false
            },
            "text": {
              "titleSize": 18,
              "valueSize": 36
            }
          },
          "description": "선택한 SSD 중 NVMe critical-warning bitmask가 0이 아닌 device 수입니다. SMART exporter가 없으면 N/A입니다."
        },
        {
