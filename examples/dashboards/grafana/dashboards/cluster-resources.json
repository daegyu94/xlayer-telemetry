{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU busy by node (%)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])))",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "noValue": "N/A"
        },
        "overrides": []
      },
      "description": "Node 전체 CPU busy 비율입니다. 특정 Run의 CPU 사용량이 아닙니다."
    },
    {
      "type": "timeseries",
      "title": "Host memory used by node (%)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "noValue": "N/A"
        },
        "overrides": []
      },
      "description": "Node 전체 memory 사용 비율입니다. Application allocation과 구분합니다."
    },
    {
      "type": "timeseries",
      "title": "GPU utilization (%)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_GPU_UTIL",
          "legendFormat": "{{instance}} GPU {{gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "noValue": "N/A"
        },
        "overrides": []
      },
      "description": "DCGM exporter의 device별 GPU utilization입니다. N/A이면 DCGM 연결을 확인합니다."
    },
    {
      "type": "timeseries",
      "title": "GPU framebuffer used",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_FB_USED * 1024 * 1024",
          "legendFormat": "{{instance}} GPU {{gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "description": "DCGM GPU framebuffer 사용량입니다. Host memory와 중복 계산하지 않습니다."
    },
    {
      "type": "timeseries",
      "title": "TCP/Ethernet network throughput",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (instance) (rate(node_network_receive_bytes_total{device!~\"lo|docker.*|veth.*\"}[1m]))",
          "legendFormat": "{{instance}} RX"
        },
        {
          "expr": "sum by (instance) (rate(node_network_transmit_bytes_total{device!~\"lo|docker.*|veth.*\"}[1m]))",
          "legendFormat": "{{instance}} TX"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "description": "Node/interface의 TCP/Ethernet bytes/s입니다. Endpoint pair별 traffic은 아닙니다."
    },
    {
      "type": "timeseries",
      "title": "RDMA (InfiniBand/RoCE) throughput",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (instance) (rate(node_infiniband_port_data_received_bytes_total[1m]))",
          "legendFormat": "{{instance}} RX"
        },
        {
          "expr": "sum by (instance) (rate(node_infiniband_port_data_transmitted_bytes_total[1m]))",
          "legendFormat": "{{instance}} TX"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "description": "지원 NIC의 InfiniBand/RoCE port bytes/s입니다. 개별 NCCL·3FS 요청별 사용량은 아닙니다."
    },
    {
      "type": "timeseries",
      "title": "Disk I/O busy time",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "rate(node_disk_io_time_seconds_total[1m])",
          "legendFormat": "{{instance}} {{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "noValue": "N/A"
        },
        "overrides": []
      },
      "description": "Device에서 I/O가 진행 중이던 시간 비율입니다. Latency p99가 아니며 Run별로 분리되지 않습니다."
    }
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": [
    "llm",
    "telemetry",
    "multinode"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Multinode LLM Cluster Resources",
  "uid": "llm-cluster-resources",
  "version": 2,
  "description": "Compose 예제의 node 자원·DCGM GPU·network·disk를 확인합니다. VERL step이나 Run별 attribution은 별도 integration이 필요합니다."
}
