  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Collect → Correlate → Diagnose",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "<span style=\"font-size:16px;line-height:1.65\">**Cluster:** ${cluster:text} · **Run:** ${run_id:text} · **Resource node:** ${node:text}<br>먼저 수집 상태와 age를 확인합니다. 아래 Run을 선택한 뒤 느린 step을 조사합니다.</span>"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Collector availability",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"telemetry\",cluster=~\"$cluster\",nodename=~\"$node\"}",
          "instant": true,
          "legendFormat": "{{nodename}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "N/A",
                  "color": "gray"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "titleSize": 18,
          "valueSize": 36
        },
        "colorMode": "value"
      },
      "description": "각 target의 scrape 상태입니다. Up은 exporter 연결 성공이며 bridge·GPU·native source의 completeness나 workload 정상 판정이 아닙니다."
    },
    {
      "id": 3,
