{
  "annotations": {
    "list": []
  },
  "description": "VERL run의 collector·sample freshness를 확인하고, 느린 step에서 candidate·evidence·resource detail로 이어지는 시작 화면입니다. 수집 상태와 workload 진단 결과를 구분합니다.",
  "editable": true,
  "links": [
    {
      "title": "Run Overview",
      "type": "link",
      "url": "/d/telemetry-overview?${cluster:queryparam}&${node:queryparam}&${run_id:queryparam}&${source_node:queryparam}&${record_id:queryparam}&${trace_id:queryparam}&${diagnosis_method:queryparam}&${log_run_id:queryparam}&${gpu:queryparam}&${engine:queryparam}&${sandbox_node:queryparam}",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Bottleneck Summary",
      "type": "link",
      "url": "/d/xlayer-bottleneck-summary?${cluster:queryparam}&${node:queryparam}&${run_id:queryparam}&${source_node:queryparam}&${record_id:queryparam}&${trace_id:queryparam}&${diagnosis_method:queryparam}&${log_run_id:queryparam}&${gpu:queryparam}&${engine:queryparam}&${sandbox_node:queryparam}",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Cross-Layer Timeline",
      "type": "link",
      "url": "/d/xlayer-cross-layer-timeline?${cluster:queryparam}&${node:queryparam}&${run_id:queryparam}&${source_node:queryparam}&${record_id:queryparam}&${trace_id:queryparam}&${diagnosis_method:queryparam}&${log_run_id:queryparam}&${gpu:queryparam}&${engine:queryparam}&${sandbox_node:queryparam}",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
