              "step": 2
            },
            "renameByName": {
              "window_start_ms": "Start Time",
              "window_end_ms": "End Time",
              "step": "Step"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 75,
            "lineWidth": 0,
            "spanNulls": false
          },
          "links": []
        },
        "overrides": []
      },
      "options": {
        "mergeValues": false,
        "showValue": "auto",
        "rowHeight": 0.8,
        "alignValue": "left",
        "legend": {
          "showLegend": false
        }
      }
