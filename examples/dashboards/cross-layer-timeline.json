{
  "annotations": {
    "list": [
      {
        "name": "Step completion (approximate)",
        "datasource": {
          "type": "loki",
          "uid": "telemetry-loki"
        },
        "enable": true,
        "hide": false,
        "iconColor": "#ffb357",
        "expr": "{signal=\"verl_step\",cluster=~\"$cluster\",node=~\"$source_node\"} | json | run_id=~\"$run_id\" | record_id=~\"$record_id\" | window_start_ms != \"\" | __error__=\"\" | line_format \"Step {{.step}} · {{.boundary_accuracy}} completion (logger observation)\"",
        "maxLines": 100
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": [
    "xlayer",
    "diagnosis"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "telemetry-loki"
        },
        "query": "label_values({signal=\"verl_step\"}, cluster)",
        "definition": "label_values({signal=\"verl_step\"}, cluster)",
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "description": "Prometheus·Loki target에 설정한 Cluster입니다. 다른 cluster의 같은 node 이름과 구분합니다."
      },
      {
        "name": "run_id",
        "label": "Run",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "description": "Application/step의 Run입니다. Host·GPU·native shared-service metric을 Run별로 나누지는 않습니다."
      },
      {
        "name": "node",
        "label": "Resource node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "telemetry-prometheus"
        },
        "query": "label_values(up{job=\"telemetry\",cluster=~\"$cluster\"}, nodename)",
        "definition": "label_values(up{job=\"telemetry\",cluster=~\"$cluster\"}, nodename)",
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "description": "GPU·host·NIC·disk를 조사할 resource node입니다. Application/step의 observer node와 독립적이며 shared 자원을 Run에 자동 귀속하지 않습니다."
      },
      {
        "name": "record_id",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 0,
        "label": "Step record ID",
        "description": "Step Explorer에서 선택한 record ID입니다. 비우면 시간 구간의 여러 record가 나타날 수 있습니다."
      },
      {
        "name": "trace_id",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 0,
        "label": "Trace ID",
        "description": "EventRecorder의 Trace ID입니다. 지정하면 관련 span/event로 좁힙니다."
      },
      {
        "name": "source_node",
        "label": "Observer node",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "description": "Step/diagnosis event를 만든 collector node입니다. Resource node와 독립적으로 유지합니다.",
        "hide": 2
      },
      {
        "name": "diagnosis_method",
        "label": "Method",
        "type": "textbox",
        "query": "rule",
        "current": {
          "text": "rule",
          "value": "rule"
        },
        "description": "Rule 또는 수동 LLM 진단의 선택을 화면 이동 시 유지합니다.",
        "hide": 2
      },
      {
        "name": "log_run_id",
        "label": "Log directory",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 2,
        "description": "Log directory 필터를 telemetry Run과 독립적으로 유지합니다."
      },
      {
        "name": "gpu",
        "label": "GPU",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 2,
        "description": "상세 화면의 GPU 선택을 navigation에서 유지합니다."
      },
      {
        "name": "engine",
        "label": "vLLM engine",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 2,
        "description": "상세 화면의 vLLM engine 선택을 navigation에서 유지합니다."
      },
      {
        "name": "sandbox_node",
        "label": "Sandbox node",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 2,
        "description": "상세 화면의 Sandbox node 선택을 navigation에서 유지합니다."
      }
    ]
  },
