  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Boundary precision",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "<span style=\"font-size:16px;line-height:1.65\">**Correlate in time:** Exact = span 경계 · Approximate = logger 기반 step 구간 · Sampled = metric.<br>Resource node·Trace ID·clock·freshness를 확인합니다. Stage duration으로 실행 순서를 만들지 않으며 shared signal은 supporting evidence입니다.</span>"
      }
    },
    {
      "id": 2,
      "type": "state-timeline",
      "title": "Exact workload spans",
      "description": "Producer node의 wall clock으로 기록한 실제 span 경계입니다. Node 간 정렬에는 clock 동기화가 필요하며 wall-clock jump가 감지된 span은 제외합니다.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "loki",
        "uid": "telemetry-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{signal=\"xlayer_event\",cluster=~\"$cluster\"} | json | run_id=~\"$run_id\" | trace_id=~\"$trace_id\" | record_type=\"span\" | __error__=\"\" | boundary_accuracy=\"exact\"",
          "queryType": "range",
          "maxLines": 5000
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "json",
            "replace": true,
            "keepTime": false
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "start_time_ms",
                "destinationType": "time"
              },
              {
                "targetField": "end_time_ms",
                "destinationType": "time"
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "schema_version": true,
              "record_type": true,
              "run_id": true,
              "producer": true,
              "role": true,
              "worker_id": true,
              "node": true,
              "rank": true,
              "local_rank": true,
              "gpu": true,
              "name": true,
              "step": true,
              "start_time_unix_nano": true,
              "end_time_unix_nano": true,
              "event_time_unix_nano": true,
              "duration_seconds": true,
              "status": true,
              "trace_id": true,
              "span_id": true,
              "attributes": true,
              "boundary_accuracy": true
            },
            "indexByName": {
              "start_time_ms": 0,
              "end_time_ms": 1,
              "phase": 2
            },
            "renameByName": {
              "start_time_ms": "Start Time",
              "end_time_ms": "End Time",
              "phase": "Phase"
            }
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Start Time",
                "End Time",
                "Phase"
              ]
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 75,
            "lineWidth": 0,
            "spanNulls": false
          },
          "links": []
        },
        "overrides": []
      },
      "options": {
        "mergeValues": false,
        "showValue": "auto",
        "rowHeight": 0.8,
        "alignValue": "left",
        "legend": {
          "showLegend": false
        }
      }
    },
