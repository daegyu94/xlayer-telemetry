  "refresh": "10s",
  "schemaVersion": 41,
  "tags": [
    "agent-rl",
    "telemetry"
  ],
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "telemetry-loki"
        },
        "query": "label_values({signal=\"verl_step\"}, cluster)",
        "definition": "label_values({signal=\"verl_step\"}, cluster)",
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "description": "Prometheus·Loki target에 설정한 Cluster입니다. 다른 cluster의 같은 node 이름과 구분합니다."
      },
      {
        "name": "source_node",
        "label": "Observer node",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "telemetry-loki"
        },
        "query": "label_values({signal=\"verl_step\",cluster=~\"$cluster\"}, node)",
        "definition": "label_values({signal=\"verl_step\",cluster=~\"$cluster\"}, node)",
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "description": "VERL step event를 관측한 collector node입니다. 실제 Resource node와 다를 수 있습니다."
      },
      {
        "name": "run_id",
        "label": "Run",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "description": "Application/step의 Run입니다. Host·GPU·native shared-service metric을 Run별로 나누지는 않습니다."
      },
      {
        "name": "node",
        "label": "Resource node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "telemetry-prometheus"
        },
        "query": "label_values(up{job=\"telemetry\",cluster=~\"$cluster\"}, nodename)",
        "definition": "label_values(up{job=\"telemetry\",cluster=~\"$cluster\"}, nodename)",
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "description": "GPU·host·NIC·disk를 조사할 resource node입니다. Application/step의 observer node와 독립적이며 shared 자원을 Run에 자동 귀속하지 않습니다.",
        "hide": 2
      },
      {
        "name": "record_id",
        "label": "Step record ID",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "description": "선택한 step identity를 상세 화면을 왕복할 때 유지합니다.",
        "hide": 2
      },
      {
        "name": "trace_id",
        "label": "Trace ID",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "description": "Exact span/event의 trace context입니다. Step record와 다른 식별자입니다.",
        "hide": 2
      },
      {
        "name": "diagnosis_method",
        "label": "Method",
        "type": "textbox",
        "query": "rule",
        "current": {
          "text": "rule",
          "value": "rule"
        },
        "description": "Rule 또는 수동 LLM 진단의 선택을 화면 이동 시 유지합니다.",
        "hide": 2
      },
      {
        "name": "log_run_id",
        "label": "Log directory",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 2,
        "description": "Log directory 필터를 telemetry Run과 독립적으로 유지합니다."
      },
      {
        "name": "gpu",
        "label": "GPU",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 2,
        "description": "상세 화면의 GPU 선택을 navigation에서 유지합니다."
      },
      {
        "name": "engine",
        "label": "vLLM engine",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 2,
        "description": "상세 화면의 vLLM engine 선택을 navigation에서 유지합니다."
      },
      {
        "name": "sandbox_node",
        "label": "Sandbox node",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 2,
        "description": "상세 화면의 Sandbox node 선택을 navigation에서 유지합니다."
      }
    ]
  },
  "time": {
    "from": "now-24h",
