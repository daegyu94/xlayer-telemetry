  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Select a completed step",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "<span style=\"font-size:16px;line-height:1.65\">**Select a slow step:** Duration → Bottleneck Summary · Stage → Cross-Layer Timeline · Step → Step Detail.<br>Observer node는 step 기록의 출처입니다. Resource node는 상세 화면에서 별도로 선택하며 Boundary를 확인합니다.</span>"
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Completed VERL steps",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 18
      },
      "datasource": {
        "type": "loki",
        "uid": "telemetry-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{signal=\"verl_step\",cluster=~\"$cluster\",node=~\"$source_node\"} | json | run_id=~\"$run_id\" | window_start_ms != \"\" | __error__=\"\" | line_format `{{ printf \"{\\\"cluster\\\":%q,\\\"observer_node\\\":%q,\\\"record\\\":%s}\" .cluster .node (__line__) }}`",
          "queryType": "range",
          "maxLines": 1000
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "json",
            "replace": true,
            "keepTime": true
          }
        },
        {
          "id": "extractFields",
          "options": {
            "source": "record",
            "format": "json",
            "replace": false,
            "keepTime": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "step": 1,
              "run_id": 2,
              "node": 3,
              "worker_id": 4,
              "boundary_scope": 5,
              "step_duration_seconds": 6,
              "stage_summary": 7,
              "record_id": 9,
              "cluster": 0
            },
            "renameByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "links": []
        },
