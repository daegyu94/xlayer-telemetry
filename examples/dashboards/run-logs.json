  "panels": [
    {
      "datasource": {
        "type": "loki",
        "uid": "telemetry-loki"
      },
      "gridPos": {
        "h": 20,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "id": 1,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{cluster=~\"$cluster\", node=~\"$node\", workload=~\"$workload\",signal!=\"verl_step\",signal!=\"xlayer_diagnosis\",signal!=\"xlayer_event\"} | unpack | run_id=~\"$run_id\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Node-local run logs",
      "type": "logs",
      "description": "선택한 Cluster·Node·Workload·Run과 시간 구간의 log입니다. Run은 log directory에서 추출한 이름이며 telemetry run_id와 다를 수 있습니다. 비어 있으면 Loki·Alloy 경로와 실제 directory 이름을 확인합니다."
    },
    {
      "id": 90,
      "type": "text",
      "title": "Log source & context",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "<span style=\"font-size:17px;line-height:1.65\">**Log detail:** Cluster · Node · Workload · Log directory로 필터합니다. Run context는 조사 중인 application을 유지합니다.<br>Log directory와 telemetry run_id는 다를 수 있습니다. 빈 panel은 정상 판정이 아니며 Loki·Alloy·log 경로를 확인합니다.</span>"
      },
      "transparent": true
    }
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": [
    "logs",
    "telemetry"
  ],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "loki",
          "uid": "telemetry-loki"
        },
        "definition": "label_values(cluster)",
        "includeAll": true,
        "label": "Cluster",
        "multi": true,
        "name": "cluster",
        "query": "label_values(cluster)",
        "refresh": 2,
        "type": "query",
        "description": "Prometheus·Loki target에 설정한 Cluster입니다. 다른 cluster의 같은 node 이름과 구분합니다."
      },
      {
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "label": "Log directory",
        "name": "run_id",
        "query": ".*",
        "type": "textbox",
        "description": "Alloy가 log 경로에서 추출한 directory 이름입니다. 기존 var-run_id URL 필터를 유지합니다. Application의 Run context와 다를 수 있습니다."
      },
      {
        "name": "source_node",
        "label": "Observer",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "description": "Step/diagnosis event를 만든 collector node입니다. Resource node와 독립적으로 유지합니다.",
        "hide": 2
      },
      {
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "loki",
          "uid": "telemetry-loki"
        },
        "definition": "label_values({cluster=~\"$cluster\"}, node)",
        "includeAll": true,
        "label": "Resource",
        "multi": true,
        "name": "node",
        "query": "label_values({cluster=~\"$cluster\"}, node)",
        "refresh": 2,
        "type": "query",
        "description": "관측할 node입니다. GPU·host·shared-service 값은 Run별로 자동 분리되지 않습니다."
      },
      {
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "loki",
          "uid": "telemetry-loki"
        },
        "definition": "label_values({cluster=~\"$cluster\", node=~\"$node\"}, workload)",
        "includeAll": true,
        "label": "Workload",
        "multi": true,
        "name": "workload",
        "query": "label_values({cluster=~\"$cluster\", node=~\"$node\"}, workload)",
        "refresh": 2,
        "type": "query",
        "description": "Alloy가 log root에 지정한 Workload label입니다."
      },
      {
        "name": "record_id",
        "label": "Record",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "description": "선택한 step identity를 상세 화면을 왕복할 때 유지합니다.",
        "hide": 2
      },
      {
        "name": "trace_id",
        "label": "Trace",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "description": "Exact span/event의 trace context입니다. Step record와 다른 식별자입니다.",
        "hide": 2
      },
      {
        "name": "diagnosis_method",
        "label": "Method",
        "type": "textbox",
        "query": "rule",
        "current": {
          "text": "rule",
          "value": "rule"
        },
        "description": "Rule 또는 수동 LLM 진단의 선택을 화면 이동 시 유지합니다.",
        "hide": 2
      },
      {
        "name": "gpu",
        "label": "GPU",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 2,
        "description": "상세 화면의 GPU 선택을 navigation에서 유지합니다."
      },
      {
        "name": "engine",
        "label": "Engine",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 2,
        "description": "상세 화면의 vLLM engine 선택을 navigation에서 유지합니다."
      },
      {
        "name": "sandbox_node",
        "label": "Sandbox",
