{
  "annotations": {
    "list": [
      {
        "name": "Step completion (approximate)",
        "datasource": {
          "type": "loki",
          "uid": "telemetry-loki"
        },
        "enable": true,
        "hide": false,
        "iconColor": "#ffb357",
        "expr": "{signal=\"verl_step\",cluster=~\"$cluster\",node=~\"$source_node\"} | json | run_id=~\"$run_id\" | record_id=~\"$record_id\" | window_start_ms != \"\" | __error__=\"\" | line_format \"Step {{.step}} · {{.boundary_accuracy}} completion (logger observation)\"",
        "maxLines": 100
      }
    ]
  },
  "editable": true,
  "description": "완료된 VERL step의 추정 시간 구간에서 node 자원·vLLM 신호·log를 비교합니다.",
  "links": [
    {
      "title": "Start Here",
      "type": "link",
      "url": "/d/xlayer-start-here?${cluster:queryparam}&${node:queryparam}&${run_id:queryparam}&${source_node:queryparam}&${record_id:queryparam}&${trace_id:queryparam}&${diagnosis_method:queryparam}&${log_run_id:queryparam}&${gpu:queryparam}&${engine:queryparam}&${sandbox_node:queryparam}",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Run Overview",
      "type": "link",
      "url": "/d/telemetry-overview?${cluster:queryparam}&${node:queryparam}&${run_id:queryparam}&${source_node:queryparam}&${record_id:queryparam}&${trace_id:queryparam}&${diagnosis_method:queryparam}&${log_run_id:queryparam}&${gpu:queryparam}&${engine:queryparam}&${sandbox_node:queryparam}",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Step Explorer",
      "type": "link",
      "url": "/d/xlayer-step-explorer?${cluster:queryparam}&${node:queryparam}&${run_id:queryparam}&${source_node:queryparam}&${record_id:queryparam}&${trace_id:queryparam}&${diagnosis_method:queryparam}&${log_run_id:queryparam}&${gpu:queryparam}&${engine:queryparam}&${sandbox_node:queryparam}",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Bottleneck Summary",
      "type": "link",
      "url": "/d/xlayer-bottleneck-summary?${cluster:queryparam}&${node:queryparam}&${run_id:queryparam}&${source_node:queryparam}&${record_id:queryparam}&${trace_id:queryparam}&${diagnosis_method:queryparam}&${log_run_id:queryparam}&${gpu:queryparam}&${engine:queryparam}&${sandbox_node:queryparam}",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Cross-Layer Timeline",
      "type": "link",
      "url": "/d/xlayer-cross-layer-timeline?${cluster:queryparam}&${node:queryparam}&${run_id:queryparam}&${source_node:queryparam}&${record_id:queryparam}&${trace_id:queryparam}&${diagnosis_method:queryparam}&${log_run_id:queryparam}&${gpu:queryparam}&${engine:queryparam}&${sandbox_node:queryparam}",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Agent RL Stage Correlation",
      "type": "link",
      "url": "/d/agent-rl-stage-correlation?${cluster:queryparam}&${node:queryparam}&${run_id:queryparam}&${source_node:queryparam}&${record_id:queryparam}&${trace_id:queryparam}&${diagnosis_method:queryparam}&${log_run_id:queryparam}&${gpu:queryparam}&${engine:queryparam}&${sandbox_node:queryparam}",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to read this window",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "<span style=\"font-size:16px;line-height:1.65\">**Cross-Layer Detail:** 선택한 step과 같은 시간의 자원·log를 확인합니다.<br>Resource node를 실제 배치에 맞춥니다. Step completion annotation은 logger 기반의 approximate marker이며 metric은 sampled입니다.</span>"
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Selected step and reported stages",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "telemetry-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{signal=\"verl_step\",cluster=~\"$cluster\"} | json | run_id=~\"$run_id\" | record_id=~\"$record_id\" | __error__=\"\" | line_format `{{ printf \"{\\\"cluster\\\":%q,\\\"observer_node\\\":%q,\\\"record\\\":%s}\" .cluster .node (__line__) }}`",
          "queryType": "range",
          "maxLines": 1000
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "json",
            "replace": true,
            "keepTime": true
          }
        },
        {
          "id": "extractFields",
          "options": {
            "source": "record",
            "format": "json",
            "replace": false,
            "keepTime": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "step": 1,
              "run_id": 2,
              "node": 3,
              "worker_id": 4,
              "boundary_scope": 5,
              "step_duration_seconds": 6,
              "stage_summary": 7,
              "record_id": 8,
              "boundary_accuracy": 5,
              "cluster": 0
            },
            "renameByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "links": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "analysis_window"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "execution_mode"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "observed_at"
