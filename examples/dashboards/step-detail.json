{
  "annotations": {
    "list": []
  },
  "editable": true,
  "description": "Inspect resource signals and logs in the approximate interval of one completed VERL step.",
  "links": [
    {
      "title": "Step Explorer",
      "type": "link",
      "url": "/d/xlayer-step-explorer?${cluster:queryparam}&${run_id:queryparam}",
      "includeTimeRange": false,
      "keepTime": false
    },
    {
      "title": "Agent RL Stage Correlation",
      "type": "link",
      "url": "/d/agent-rl-stage-correlation?${cluster:queryparam}&${run_id:queryparam}",
      "includeTimeRange": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to read this window",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "The step interval is estimated from the file logger observation and reported duration. Stage values are durations, not an ordered timeline. Node resources and vLLM signals can include other workloads; rate panels use a one-minute lookback."
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Selected step and reported stages",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "telemetry-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{signal=\"verl_step\",cluster=~\"$cluster\"} | json | run_id=\"$run_id\" | record_id=\"$record_id\" | __error__=\"\"",
          "queryType": "range",
          "maxLines": 1000
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "json",
            "replace": true,
            "keepTime": true
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "step": 0,
              "run_id": 1,
              "node": 2,
              "worker_id": 3,
              "boundary_scope": 4,
              "step_duration_seconds": 5,
              "stage_summary": 6,
              "record_id": 7,
              "boundary_accuracy": 4
            },
            "renameByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "links": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "analysis_window"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "execution_mode"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "observed_at"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "record_type"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "schema_version"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "stage_durations_seconds"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "window_end_ms"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "window_start_ms"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "step"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 75
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "run_id"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 165
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "node"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "step_duration_seconds"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 185
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "stage_summary"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 390
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto",
                  "wrapText": true
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "run_id"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "worker_id"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "record_id"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "boundary_accuracy"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 145
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "GPU utilization",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "telemetry_gpu_utilization_percent{job=\"telemetry\",cluster=~\"$cluster\",instance=~\"$node\"}",
          "legendFormat": "{{instance}} / GPU {{gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "N/A",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Compute-process GPU memory",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (telemetry_gpu_process_memory_bytes{job=\"telemetry\",cluster=~\"$cluster\",instance=~\"$node\"})",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "N/A",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Host CPU busy",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"telemetry\",cluster=~\"$cluster\",instance=~\"$node\",mode=\"idle\"}[1m])))",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "N/A",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Host memory used",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
