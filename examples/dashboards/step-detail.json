  "refresh": "",
  "schemaVersion": 41,
  "tags": [
    "agent-rl",
    "telemetry"
  ],
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "telemetry-loki"
        },
        "query": "label_values({signal=\"verl_step\"}, cluster)",
        "definition": "label_values({signal=\"verl_step\"}, cluster)",
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "run_id",
        "label": "Run",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      },
      {
        "name": "record_id",
        "label": "Step record",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      },
      {
        "name": "node",
        "label": "Resource node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "telemetry-prometheus"
        },
        "query": "label_values(up{job=\"telemetry\",cluster=~\"$cluster\"}, instance)",
        "definition": "label_values(up{job=\"telemetry\",cluster=~\"$cluster\"}, instance)",
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "workload",
        "label": "Workload",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "telemetry-loki"
        },
        "query": "label_values({cluster=~\"$cluster\"}, workload)",
        "definition": "label_values({cluster=~\"$cluster\"}, workload)",
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "log_run_id",
        "label": "Log directory",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      }
    ]
  },
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "title": "07 · Step Detail",
  "uid": "xlayer-step-detail",
  "version": 1
}
