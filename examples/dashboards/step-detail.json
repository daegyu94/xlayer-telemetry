        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Node/device의 disk read bytes/s입니다. 1분 lookback이며 특정 sandbox·3FS 요청에 자동 귀속하지 않습니다."
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Disk write",
      "gridPos": {
        "x": 12,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(node_disk_written_bytes_total{job=\"telemetry\",cluster=~\"$cluster\",instance=~\"$node\"}[1m]))",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "noValue": "N/A",
