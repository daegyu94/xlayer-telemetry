    {
      "id": 13,
      "type": "logs",
      "title": "Run logs in this step window",
      "gridPos": {
        "x": 0,
        "y": 47,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "telemetry-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{cluster=~\"$cluster\",node=~\"$node\",workload=~\"$workload\",signal!=\"verl_step\"} | unpack | run_id=~\"$log_run_id\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": false,
        "prettifyLogMessage": false,
        "sortOrder": "Ascending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
