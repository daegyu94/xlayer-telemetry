        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Node/device의 disk write bytes/s입니다. 1분 lookback이며 특정 sandbox·3FS 요청에 자동 귀속하지 않습니다."
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "vLLM waiting",
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node) (vllm:num_requests_waiting{job=\"native\",cluster=~\"$cluster\",telemetry_source=\"vllm\",node=~\"$node\"})",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "선택한 node의 native vLLM waiting requests입니다. Shared engine이 처리하는 다른 Run의 요청도 포함될 수 있습니다."
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "KV offload store",
      "gridPos": {
        "x": 12,
        "y": 41,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node) (rate(vllm:kv_offload_total_bytes_total{job=\"native\",cluster=~\"$cluster\",telemetry_source=\"vllm\",node=~\"$node\",transfer_type=\"GPU_to_CPU\"}[1m]))",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "noValue": "N/A",
