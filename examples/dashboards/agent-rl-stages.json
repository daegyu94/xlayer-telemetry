{
  "annotations": {
    "list": []
  },
  "editable": true,
  "links": [
    {
      "includeTimeRange": false,
      "keepTime": false,
      "title": "Start Here",
      "type": "link",
      "url": "/d/xlayer-start-here"
    },
    {
      "includeTimeRange": false,
      "keepTime": false,
      "title": "Step Explorer",
      "type": "link",
      "url": "/d/xlayer-step-explorer?${cluster:queryparam}&${run_id:queryparam}"
    },
    {
      "includeTimeRange": true,
      "keepTime": true,
      "title": "Run Overview",
      "type": "link",
      "url": "/d/telemetry-overview?${cluster:queryparam}&${node:queryparam}&${run_id:queryparam}"
    },
    {
      "includeTimeRange": true,
      "keepTime": true,
      "title": "Compute & Communication",
      "type": "link",
      "url": "/d/xlayer-compute-communication?${cluster:queryparam}&${node:queryparam}&${run_id:queryparam}"
    },
    {
      "includeTimeRange": true,
      "keepTime": true,
      "title": "Data & Storage",
      "type": "link",
      "url": "/d/xlayer-data-storage?${cluster:queryparam}&${node:queryparam}&${run_id:queryparam}"
    },
    {
      "includeTimeRange": true,
      "keepTime": true,
      "title": "Run Logs",
      "type": "link",
      "url": "/d/xlayer-run-logs?${cluster:queryparam}&${node:queryparam}&${run_id:queryparam}"
    },
    {
      "title": "Bottleneck Summary",
      "type": "link",
      "url": "/d/xlayer-bottleneck-summary?${cluster:queryparam}&${run_id:queryparam}",
      "includeTimeRange": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Latest completed RL step",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(training_step{job=\"telemetry\",cluster=~\"$cluster\",nodename=~\"$node\",run_id=~\"$run_id\",role=~\"$role\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "titleSize": 16,
          "valueSize": 64
        }
      },
      "description": "Last completed VERL training step. This value is intentionally retained between updates; use worker sample age to tell a long in-progress step or stopped run from fresh data."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Latest completed reward mean",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "reward_mean{job=\"telemetry\",cluster=~\"$cluster\",nodename=~\"$node\",run_id=~\"$run_id\"}",
          "instant": true,
          "legendFormat": "{{role}}/{{worker_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "titleSize": 16,
          "valueSize": 64
        }
      },
      "description": "Last completed reward scalar, retained between step updates. This is not a live indication that reward computation is currently running; check worker sample age."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Worker sample age",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - training_sample_timestamp_seconds{job=\"telemetry\",cluster=~\"$cluster\",nodename=~\"$node\",run_id=~\"$run_id\",role=~\"$role\"}",
          "instant": true,
          "legendFormat": "{{instance}} {{role}}/{{worker_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "titleSize": 16,
          "valueSize": 64
        }
      },
      "description": "Age since each worker last completed a logger update. A growing value can mean a long step, a stalled worker, or failed metric export."
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Completed RL stage duration (step boundary)",
      "description": "VERL emits timing_s/* after logger.log at step completion. This panel does not identify the currently running phase; use RL-Insight state traces and live native metrics for in-progress work.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rl_stage_duration_seconds{job=\"telemetry\",cluster=~\"$cluster\",nodename=~\"$node\",run_id=~\"$run_id\",phase=~\"$phase\",role=~\"$role\",worker_id=~\"$worker\"}",
          "legendFormat": "{{phase}} {{instance}}/{{worker_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Completed step throughput and response length",
      "description": "VERL perf/throughput divides batch tokens by the full step duration and GPU count. This is not the live rollout engine token rate.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "training_tokens_per_second_per_gpu{job=\"telemetry\",cluster=~\"$cluster\",nodename=~\"$node\",run_id=~\"$run_id\"}",
          "legendFormat": "tokens/s/GPU {{worker_id}}"
        },
        {
          "refId": "B",
          "expr": "rollout_output_tokens_mean{job=\"telemetry\",cluster=~\"$cluster\",nodename=~\"$node\",run_id=~\"$run_id\"}",
          "legendFormat": "output tokens {{worker_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "GPU utilization by selected node",
      "description": "Host-wide signal. Use worker GPU allocation and the run manifest before attributing it to this run.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "telemetry_gpu_utilization_percent{job=\"telemetry\",cluster=~\"$cluster\",nodename=~\"$node\"} and on(cluster, instance) (time() - telemetry_gpu_sample_timestamp_seconds{job=\"telemetry\",cluster=~\"$cluster\",nodename=~\"$node\"} < 30)",
          "legendFormat": "{{instance}} GPU {{gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Weight sync and policy lag",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rl_stage_duration_seconds{job=\"telemetry\",cluster=~\"$cluster\",nodename=~\"$node\",run_id=~\"$run_id\",phase=\"weight_sync\"}",
          "legendFormat": "sync {{instance}}/{{worker_id}}"
        },
        {
          "refId": "B",
          "expr": "policy_version_lag{job=\"telemetry\",cluster=~\"$cluster\",nodename=~\"$node\",run_id=~\"$run_id\"}",
          "legendFormat": "lag {{replica}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "description": "Weight-sync duration from VERL is step-complete. Policy lag can be live only when rollout replicas emit it directly."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Tool and reward signals",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "agent_tool_call_duration_seconds{job=\"telemetry\",cluster=~\"$cluster\",nodename=~\"$node\",run_id=~\"$run_id\"}",
          "legendFormat": "tool {{tool}}"
        },
        {
          "refId": "B",
          "expr": "rl_stage_duration_seconds{job=\"telemetry\",cluster=~\"$cluster\",nodename=~\"$node\",run_id=~\"$run_id\",phase=\"reward\"}",
          "legendFormat": "reward {{worker_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "description": "Application metrics update when their producer emits. High-cardinality tool/request evidence belongs in event or trace storage."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Live rollout engine signals",
      "description": "Native vLLM endpoint scraped independently of VERL step completion. Selected by cluster and node, not run_id: shared engines may include other runs. Metric availability and names depend on the deployed vLLM version.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vllm:num_requests_waiting{job=\"native\",cluster=~\"$cluster\",telemetry_source=\"vllm\",node=~\"$node\"}",
          "legendFormat": "waiting {{component}}"
        },
        {
          "refId": "B",
          "expr": "vllm:kv_cache_usage_perc{job=\"native\",cluster=~\"$cluster\",telemetry_source=\"vllm\",node=~\"$node\"}",
          "legendFormat": "KV usage {{component}}"
        },
        {
          "refId": "C",
          "expr": "rate(vllm:num_preemptions_total{job=\"native\",cluster=~\"$cluster\",telemetry_source=\"vllm\",node=~\"$node\"}[$__rate_interval])",
          "legendFormat": "preemptions/s {{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "vLLM KV offload store and load",
      "description": "Native vLLM offload bytes scraped independently of VERL steps. These counters include all configured offload tiers and are scoped by cluster and node, not run_id. Pair them with host disk I/O and the configured filesystem tier to identify file offloading.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 37
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(vllm:kv_offload_total_bytes_total{job=\"native\",cluster=~\"$cluster\",telemetry_source=\"vllm\",node=~\"$node\",transfer_type=\"GPU_to_CPU\"}[$__rate_interval])",
          "legendFormat": "store {{telemetry_name}}"
        },
        {
          "refId": "B",
          "expr": "rate(vllm:kv_offload_total_bytes_total{job=\"native\",cluster=~\"$cluster\",telemetry_source=\"vllm\",node=~\"$node\",transfer_type=\"CPU_to_GPU\"}[$__rate_interval])",
          "legendFormat": "load {{telemetry_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Sandbox pool occupancy",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 45
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sandbox_active{job=\"telemetry\",cluster=~\"$cluster\",nodename=~\"$node\",role=\"sandbox\"}",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "expr": "sandbox_queued{job=\"telemetry\",cluster=~\"$cluster\",nodename=~\"$node\",role=\"sandbox\"}",
          "legendFormat": "queued"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "description": "Optional runtime adapter gauges. Select the sandbox node for a dedicated deployment."
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Sandbox worker I/O pressure",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 45
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sandbox_io_pressure_ratio{job=\"telemetry\",cluster=~\"$cluster\",nodename=~\"$node\",role=\"sandbox\"}",
          "legendFormat": "I/O PSI"
        },
        {
          "refId": "B",
          "expr": "rate(node_disk_io_time_seconds_total{job=\"telemetry\",cluster=~\"$cluster\",nodename=~\"$node\"}[$__rate_interval])",
          "legendFormat": "local device busy"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "description": "I/O PSI is sandbox-worker cgroup scope; device busy is node/device scope. Select the sandbox node and backing device before comparing."
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Sandbox worker I/O rate",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 53
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(sandbox_io_read_bytes_total{job=\"telemetry\",cluster=~\"$cluster\",nodename=~\"$node\",role=\"sandbox\"}[$__rate_interval])",
          "legendFormat": "read"
        },
        {
          "refId": "B",
          "expr": "rate(sandbox_io_write_bytes_total{job=\"telemetry\",cluster=~\"$cluster\",nodename=~\"$node\",role=\"sandbox\"}[$__rate_interval])",
          "legendFormat": "write"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "description": "Aggregate cgroup bytes on the selected sandbox node. No sandbox or trajectory ID labels."
    },
