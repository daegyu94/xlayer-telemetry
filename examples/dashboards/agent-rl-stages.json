    {
      "id": 17,
      "type": "stat",
      "title": "Sandbox sample age",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 69
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
