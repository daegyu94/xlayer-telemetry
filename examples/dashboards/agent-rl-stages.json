  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": [
    "agent-rl",
    "telemetry"
  ],
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "telemetry-prometheus"
        },
        "query": "label_values(training_sample_timestamp_seconds, cluster)",
        "definition": "label_values(training_sample_timestamp_seconds, cluster)",
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1
      },
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
