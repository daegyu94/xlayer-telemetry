      "type": "timeseries",
      "title": "Sandbox worker I/O operations",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 53
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(sandbox_io_read_ops_total{job=\"telemetry\",cluster=~\"$cluster\",nodename=~\"$node\",role=\"sandbox\"}[$__rate_interval])",
          "legendFormat": "read ops/s"
        },
        {
          "refId": "B",
          "expr": "rate(sandbox_io_write_ops_total{job=\"telemetry\",cluster=~\"$cluster\",nodename=~\"$node\",role=\"sandbox\"}[$__rate_interval])",
          "legendFormat": "write ops/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "description": "Aggregate cgroup operations, not per-tool attribution."
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Sandbox worker memory",
      "gridPos": {
