        },
        "definition": "label_values(up{job=\"telemetry\", cluster=~\"$cluster\"}, instance)",
        "query": "label_values(up{job=\"telemetry\", cluster=~\"$cluster\"}, instance)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
