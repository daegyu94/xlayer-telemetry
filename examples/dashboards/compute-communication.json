      "type": "link",
      "url": "/d/telemetry-overview?${cluster:queryparam}&${node:queryparam}&${run_id:queryparam}"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "GPU utilization matrix (latest sample)",
      "description": "행은 cluster/node, 열은 GPU index입니다. 30초보다 오래된 sample은 숨깁니다. 0%는 측정된 idle, N/A는 근거 없음입니다. Run 필터는 적용되지 않습니다.",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_join((telemetry_gpu_utilization_percent{job=\"telemetry\",cluster=~\"$cluster\",instance=~\"$node\"} and on(cluster, instance) (time() - telemetry_gpu_sample_timestamp_seconds{job=\"telemetry\",cluster=~\"$cluster\",instance=~\"$node\"} < 30)), \"node\", \"/\", \"cluster\", \"instance\")",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "N/A",
          "custom": {
            "cellOptions": {
              "type": "color-background"
            }
          },
          "min": 0,
          "max": 100,
          "decimals": 0,
          "color": {
            "mode": "continuous-BlPu"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        },
        "cellHeight": "lg",
        "enablePagination": true
      },
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "gpu",
            "rowField": "node",
            "valueField": "Value"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "GPU utilization",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(telemetry_gpu_utilization_percent{job=\"telemetry\",cluster=~\"$cluster\",instance=~\"$node\"}) and on(cluster, instance) (time() - telemetry_gpu_sample_timestamp_seconds{job=\"telemetry\",cluster=~\"$cluster\",instance=~\"$node\"} < 30)",
          "legendFormat": "{{cluster}}/{{instance}} GPU {{gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "description": "Device별 GPU utilization입니다. Worker allocation과 함께 보며 특정 Run의 사용량으로 자동 귀속하지 않습니다."
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "GPU power",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(telemetry_gpu_power_watts{job=\"telemetry\",cluster=~\"$cluster\",instance=~\"$node\"}) and on(cluster, instance) (time() - telemetry_gpu_sample_timestamp_seconds{job=\"telemetry\",cluster=~\"$cluster\",instance=~\"$node\"} < 30)",
          "legendFormat": "{{cluster}}/{{instance}} GPU {{gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "description": "Device별 GPU power입니다. Utilization·temperature·SM clock과 같은 시간 구간에서 비교합니다."
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "GPU temperature",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(telemetry_gpu_temperature_celsius{job=\"telemetry\",cluster=~\"$cluster\",instance=~\"$node\"}) and on(cluster, instance) (time() - telemetry_gpu_sample_timestamp_seconds{job=\"telemetry\",cluster=~\"$cluster\",instance=~\"$node\"} < 30)",
          "legendFormat": "{{cluster}}/{{instance}} GPU {{gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "description": "Device별 GPU temperature입니다. 온도만으로 throttling을 단정하지 않고 power·SM clock 변화를 함께 확인합니다."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "GPU SM clock",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(telemetry_gpu_sm_clock_mhz{job=\"telemetry\",cluster=~\"$cluster\",instance=~\"$node\"}) and on(cluster, instance) (time() - telemetry_gpu_sample_timestamp_seconds{job=\"telemetry\",cluster=~\"$cluster\",instance=~\"$node\"} < 30)",
          "legendFormat": "{{cluster}}/{{instance}} GPU {{gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "mhz",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "description": "Device별 GPU SM clock입니다. Clock 감소가 있으면 부하·temperature·power 상태와 함께 조사합니다."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Compute-process GPU memory",
      "description": "nvidia-smi의 compute-process GPU memory입니다. PID를 표시하지만 전체 unified-memory 사용량이나 Run 소유 관계를 증명하지 않습니다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(telemetry_gpu_process_memory_bytes{job=\"telemetry\",cluster=~\"$cluster\",instance=~\"$node\"}) and on(cluster, instance) (time() - telemetry_gpu_sample_timestamp_seconds{job=\"telemetry\",cluster=~\"$cluster\",instance=~\"$node\"} < 30)",
          "legendFormat": "{{cluster}}/{{instance}} PID {{pid}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Worker-local application timers",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(training_timer_seconds{job=\"telemetry\",cluster=~\"$cluster\",instance=~\"$node\",run_id=~\"$run_id\"}) and on(cluster, instance, run_id, producer, role, worker_id, node, local_rank) (time() - training_sample_timestamp_seconds{job=\"telemetry\",cluster=~\"$cluster\",instance=~\"$node\",run_id=~\"$run_id\"} < $training_max_age)",
          "legendFormat": "{{cluster}}/{{instance}} {{run_id}} {{producer}}/{{role}} worker {{worker_id}} {{timer}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "description": "Application이 기록한 worker-local timer입니다. Training sample max age를 넘으면 숨기므로 긴 step에서는 기준을 조정합니다. Worker 간 합산값이 아닙니다."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "TCP/Ethernet throughput by interface",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance, device) (rate(node_network_receive_bytes_total{job=\"telemetry\",cluster=~\"$cluster\",instance=~\"$node\",device!~\"lo|docker.*|veth.*\"}[$__rate_interval]))",
          "legendFormat": "{{cluster}}/{{instance}} {{device}} RX"
        },
        {
          "refId": "B",
          "expr": "sum by (instance, device) (rate(node_network_transmit_bytes_total{job=\"telemetry\",cluster=~\"$cluster\",instance=~\"$node\",device!~\"lo|docker.*|veth.*\"}[$__rate_interval]))",
          "legendFormat": "{{cluster}}/{{instance}} {{device}} TX"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "description": "Node/interface의 TCP/Ethernet bytes/s입니다. Endpoint pair나 weight-sync·storage traffic을 자동 구분하지 않습니다."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "RDMA throughput by port",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance, device, port) (rate(node_infiniband_port_data_received_bytes_total{job=\"telemetry\",cluster=~\"$cluster\",instance=~\"$node\"}[$__rate_interval]))",
          "legendFormat": "{{cluster}}/{{instance}} {{device}}/{{port}} RX"
        },
        {
          "refId": "B",
          "expr": "sum by (instance, device, port) (rate(node_infiniband_port_data_transmitted_bytes_total{job=\"telemetry\",cluster=~\"$cluster\",instance=~\"$node\"}[$__rate_interval]))",
          "legendFormat": "{{cluster}}/{{instance}} {{device}}/{{port}} TX"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "description": "InfiniBand/RoCE port counter의 bytes/s입니다. 지원 NIC·counter가 필요하며 개별 NCCL·3FS 요청의 traffic은 아닙니다."
    },
    {
      "id": 10,
      "type": "text",
      "title": "Allocation and interconnect evidence",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 43
      },
      "options": {
        "mode": "markdown",
        "content": "<span style=\"font-size:16px;line-height:1.65\">**Allocation과 communication을 함께 읽기**</span>\n\n- <span style=\"font-size:16px;line-height:1.65\">GPU utilization은 device 전체입니다. Allocation은 선택한 age 범위의 명시적 CUDA_VISIBLE_DEVICES snapshot입니다.</span>\n- <span style=\"font-size:16px;line-height:1.65\">GPU index와 UUID는 다릅니다. Snapshot이 없거나 오래됐다는 이유로 GPU가 비어 있다고 판단하지 않습니다.</span>\n- <span style=\"font-size:16px;line-height:1.65\">TCP/RDMA는 port counter입니다. 제공된 topology만으로 endpoint 간 bandwidth·latency를 측정하지는 않습니다.</span>"
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "GPU allocation matrix",
      "description": "행은 cluster/node/run/producer/role/worker, 열은 CUDA_VISIBLE_DEVICES 식별자입니다. Index·UUID를 sampler index로 자동 정규화하지 않습니다. 최근 배치 snapshot이며 process 생존 증거는 아닙니다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 52
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_join((training_gpu_allocation{job=\"telemetry\",cluster=~\"$cluster\",instance=~\"$node\",run_id=~\"$run_id\"} and on(cluster, instance, run_id, producer, role, worker_id, node, local_rank) (time() - training_sample_timestamp_seconds{job=\"telemetry\",cluster=~\"$cluster\",instance=~\"$node\",run_id=~\"$run_id\"} < $training_max_age)), \"worker\", \"/\", \"cluster\", \"instance\", \"run_id\", \"producer\", \"role\", \"worker_id\")",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Assigned",
                  "color": "blue"
                }
              }
            }
          ],
          "custom": {
            "cellOptions": {
              "type": "color-background"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "lg",
        "enablePagination": true
      },
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "gpu",
            "rowField": "worker",
            "valueField": "Value"
          }
        }
      ]
    },
    {
      "id": 12,
      "type": "table",
      "title": "Compute topology matrix",
      "description": "선택한 Cluster의 명시적으로 제공된 edge입니다. 측정 traffic이 아니며 Node·Run 필터는 적용되지 않습니다. Publisher가 다른 node일 수 있습니다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 52
      },
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_join(label_join(max by (cluster, source, destination) (telemetry_topology_edge_info{job=\"telemetry\",cluster=~\"$cluster\",kind=\"compute\"}), \"source_key\", \"/\", \"cluster\", \"source\"), \"destination_key\", \"/\", \"cluster\", \"destination\")",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "lg",
        "enablePagination": true
      },
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "destination_key",
            "rowField": "source_key",
            "valueField": "Value"
          }
        }
      ]
    },
    {
      "id": 90,
      "type": "text",
      "title": "Compute & communication scope",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "<span style=\"font-size:16px;line-height:1.65\">Node의 GPU·host·NIC 신호를 같은 시간 구간에서 비교합니다. Allocation은 명시적 snapshot이며 shared GPU·port counter를 특정 Run에 자동 귀속하지 않습니다.</span>\n\n<span style=\"font-size:16px;line-height:1.65\">N/A이면 source 지원 여부와 sample age를 확인합니다. Run 필터는 application timer·allocation에 적용됩니다.</span>"
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": [
    "compute",
    "telemetry"
  ],
  "templating": {
    "list": [
      {
        "name": "cluster",
