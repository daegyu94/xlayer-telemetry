        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "telemetry-loki"
        },
        "query": "label_values({signal=\"verl_step\"}, cluster)",
        "definition": "label_values({signal=\"verl_step\"}, cluster)",
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "run_id",
        "label": "Run",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      },
      {
        "name": "node",
        "label": "Resource node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "telemetry-prometheus"
        },
        "query": "label_values(up{job=\"telemetry\",cluster=~\"$cluster\"}, instance)",
        "definition": "label_values(up{job=\"telemetry\",cluster=~\"$cluster\"}, instance)",
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "record_id",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 0,
        "label": "Step record ID"
      }
    ]
