          "refId": "A",
          "expr": "{signal=\"xlayer_diagnosis\",cluster=~\"$cluster\"} | json | run_id=~\"$run_id\" | row_kind=\"summary\" | record_id=~\"$record_id\" | __error__=\"\"",
          "queryType": "range",
          "maxLines": 5000
        }
      ],
      "transformations": [
