  "version": 1,
  "uid": "xlayer-bottleneck-summary",
  "title": "04 · Bottleneck Summary",
  "description": "Inspect workload-aware candidates and measured evidence. Shared signals are correlation, not attribution.",
  "links": [
    {
      "title": "Run Overview",
      "type": "link",
      "url": "/d/telemetry-overview?${cluster:queryparam}&${run_id:queryparam}",
      "includeTimeRange": true,
      "keepTime": true
    },
    {
      "title": "Cross-Layer Timeline",
      "type": "link",
      "url": "/d/xlayer-cross-layer-timeline?${cluster:queryparam}&${run_id:queryparam}&${record_id:queryparam}",
      "includeTimeRange": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Investigation path",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Run Overview → slow step → candidates → timeline → existing detail dashboards.** Select a run and a step record ID. `strong_signal` means every rule condition was observed; it does not prove causality or run ownership. A missing baseline or source is shown explicitly. Node and shared-service measurements can include other workloads."
      }
    },
