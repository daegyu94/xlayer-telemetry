  ],
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "telemetry-prometheus"
        },
        "definition": "label_values(up{job=\"telemetry\"}, cluster)",
        "query": "label_values(up{job=\"telemetry\"}, cluster)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "description": "Prometheus·Loki target에 설정한 Cluster입니다. 다른 cluster의 같은 node 이름과 구분합니다."
      },
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "telemetry-prometheus"
        },
        "definition": "label_values(up{job=\"telemetry\", cluster=~\"$cluster\"}, instance)",
        "query": "label_values(up{job=\"telemetry\", cluster=~\"$cluster\"}, instance)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "description": "관측할 node입니다. GPU·host·shared-service 값은 Run별로 자동 분리되지 않습니다."
      },
      {
        "name": "run_id",
        "label": "Run",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "telemetry-prometheus"
        },
        "definition": "label_values(training_step{job=\"telemetry\", cluster=~\"$cluster\", instance=~\"$node\"}, run_id)",
        "query": "label_values(training_step{job=\"telemetry\", cluster=~\"$cluster\", instance=~\"$node\"}, run_id)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "description": "Application/step의 Run입니다. Host·GPU·native shared-service metric을 Run별로 나누지는 않습니다."
      },
      {
        "name": "training_max_age",
        "label": "Training sample max age (s)",
        "type": "custom",
        "query": "30,60,300,900,3600",
        "current": {
          "text": "300",
          "value": "300"
        },
        "multi": false,
        "includeAll": false,
        "description": "Application snapshot을 표시할 최대 age(초)입니다. 긴 step에서 숨겨진 값을 볼 때 조정합니다."
      }
    ]
  },
