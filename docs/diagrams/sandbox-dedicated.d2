# Title: Dedicated sandbox
# Description: RPC carries trace context to a separate sandbox node; that node collects its cgroup and local device metrics.
...@_style

direction: down
gpu: GPU / rollout node {
  agent: "AgentLoop / tool.call" {class: source}
}
remote: Dedicated sandbox node {
  sandbox: "Sandbox worker / sandbox.exec\nExplicit trace / parent context" {class: source}
  filesystem: "Workspace filesystem\nExample: OverlayFS" {class: process}
  nvme: "Local SSD / NVMe" {class: process}
  cgroup: "Sandbox cgroup v2" {class: process}
  collector: "Node collector / Node Exporter\nrole=sandbox / deployment=dedicated" {class: process}
  sandbox -> filesystem -> nvme: workload path {style.font-size: 20}
  sandbox -> cgroup
  cgroup -> collector: sandbox.prom {style.font-size: 20}
  nvme -> collector: host / device metrics {style.font-size: 20}
}
gpu.agent -> remote.sandbox: sandbox RPC + trace context {style.font-size: 20}
prom: "Prometheus / XLayer\nSame metric schema, separate node identity" {class: evidence}
remote.collector -> prom
