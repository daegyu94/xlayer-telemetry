# Title: Dedicated sandbox
# Description: Solid edges show execution/RPC; dashed edges show separate cgroup and device observations on the dedicated sandbox node.
...@_style

direction: down
gpu: GPU / rollout node {
  agent: "AgentLoop / tool.call" {class: source}
}
remote: Dedicated sandbox node {
  sandbox: "Sandbox worker / sandbox.exec\nExternal runtime\nrole=sandbox / deployment=dedicated\nExplicit trace / parent context" {class: source}
  filesystem: "Workspace filesystem\nExample: OverlayFS" {class: process}
  nvme: "Local SSD / NVMe\nDevice scope" {class: process}
  cgroup: "Registered sandbox cgroup v2\nI/O / PSI / CPU / memory\nCgroup scope" {class: process}
  collector: "Cgroup sampler > sandbox.prom\nNode Exporter" {class: process}
  sandbox -> filesystem -> nvme
  sandbox -> cgroup: observe {style.stroke-dash: 4; style.font-size: 20}
  cgroup -> collector {style.stroke-dash: 4}
  nvme -> collector {style.stroke-dash: 4}
}
gpu.agent -> remote.sandbox: sandbox RPC + trace context {style.font-size: 20}
prom: "Prometheus / XLayer\nSame metric schema, separate node identity" {class: evidence}
remote.collector -> prom: scrape {style.stroke-dash: 4; style.font-size: 20}
