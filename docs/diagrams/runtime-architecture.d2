# Title: Runtime and stored-run analysis
# Description: Monitoring lifecycle, workload artifacts and optional shared-service queries are separate inputs to stored-interval diagnosis and inspection.
...@_style

direction: right
inputs: "Separate responsibilities" {
  grid-columns: 1
  grid-gap: 18
  monitor: "Monitoring: up / down\ncollectors / backends" {class: process}
  workload: "Workload: run / bridge\nsteps / spans / artifacts" {class: source}
  threefs: "Optional ClickHouse\nshared-service query" {class: optional}
}
analysis: "Stored interval\nbaseline / evidence" {class: evidence}
view: "Grafana / inspect\noptional profiler" {class: optional}
inputs -> analysis -> view {style.stroke: "#6366f1"; style.font-size: 18}
