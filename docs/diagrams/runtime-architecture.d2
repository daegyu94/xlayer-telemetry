# Title: Runtime and stored-run analysis
# Description: Persisted workload intervals and existing backend queries feed comparable baselines, diagnosis and artifact or dashboard inspection.
...@_style

direction: down
inputs: Analysis inputs {
  grid-columns: 1
  artifacts: "Run artifacts from workload + bridge\nManifest / steps / spans / health" {class: source}
  prom: "Prometheus metric queries\nNode collectors / native endpoints" {class: process}
  ch: "3FS ClickHouse queries\nSelected shared-service window" {class: optional}
}
context: "Interval + entity + scope + provenance" {class: process}
baseline: "Current / comparable baseline" {class: evidence}
analysis: "Rule or explicit LLM investigation" {class: evidence}
report: "JSON report\nSupporting / counter / missing evidence" {class: evidence}
view: "Loki projection > Grafana\nxltel inspect / targeted profiler" {class: optional}
inputs -> context -> baseline -> analysis -> report -> view
