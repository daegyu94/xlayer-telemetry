# Title: Observation scope is not attribution
# Description: Compare a verified workload interval with cgroup, device and shared-service observations; candidate evidence retains its scope and attribution gaps.
...@_style

direction: right
workload: "Run window" {class: source}
observations: "Scopes" {
  grid-columns: 1
  grid-gap: 16
  cgroup: "Cgroup" {class: process}
  device: "Device" {class: process}
  service: "Shared service" {class: process}
}
candidate: "Candidate\nnot attribution" {class: evidence}
workload -> observations {style.stroke-dash: 4}
observations -> candidate {style.stroke: "#6366f1"}
