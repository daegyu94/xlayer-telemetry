# Title: Observation scope is not attribution
# Description: Matching time and identity supports investigation; cgroup, device and shared-service evidence do not imply per-run causality.
...@_style

direction: down
workload: "Selected run / step / tool span\nWorkload interval + trace context" {class: source}
observations: Related evidence {
  grid-columns: 1
  cgroup: "Sandbox bytes / PSI\nCgroup scope" {class: process}
  device: "Local NVMe busy / queue\nNode + device scope" {class: process}
  shared: "3FS service latency\nShared-service scope" {class: process}
}
workload -> observations: join verified interval + identity {style.font-size: 20}
candidate: "Supporting bottleneck candidate\nPreserve scope / quality / counter evidence" {class: evidence}
observations -> candidate: correlated changes {style.font-size: 20}
missing: "Missing evidence\nPer-client / measured path attribution" {class: optional}
candidate -> missing: investigate before causal claim {style.font-size: 20}
