# Title: Logs, events and 3FS evidence
# Description: Alloy projects configured JSONL/log streams to Loki; diagnostics query ClickHouse separately from metrics.
...@_style

direction: down
streams: "Tool spans / completed step events" {class: source}
artifacts: "Run JSONL artifacts" {class: process}
inspect: "xltel inspect / show_run" {class: evidence}
logs: "Configured workload log files" {class: source}
alloy: "Optional Alloy" {class: optional}
loki: "Loki" {class: process}
grafana: "Grafana\nRun Logs / Run Overview / Timeline" {class: evidence}
streams -> artifacts
artifacts -> inspect
artifacts -> alloy -> loki -> grafana
logs -> alloy
fs: "3FS service distributions" {class: source}
ch: "ClickHouse" {class: process}
diag: "Selected shared-service window\nDiagnostics / standalone threefs query" {class: evidence}
fs -> ch -> diag
