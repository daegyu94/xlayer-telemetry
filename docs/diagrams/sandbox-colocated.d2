# Title: Colocated sandbox
# Description: Solid edges show execution; dashed edges show observation. Colocation does not merge sandbox cgroup and local NVMe scopes.
...@_style

direction: down
node: GPU / rollout node {
  agent: "AgentLoop > tool.call" {class: source}
  sandbox: "Sandbox worker / sandbox.exec\nExternal runtime\nrole=sandbox / deployment=colocated" {class: source}
  filesystem: "Workspace filesystem\nExample: OverlayFS" {class: process}
  nvme: "Local SSD / NVMe\nDevice scope" {class: process}
  cgroup: "Registered sandbox cgroup v2\nI/O / PSI / CPU / memory\nCgroup scope" {class: process}
  collector: "Cgroup sampler > sandbox.prom\nNode Exporter" {class: process}
  agent -> sandbox -> filesystem -> nvme
  sandbox -> cgroup: observe {style.stroke-dash: 4; style.font-size: 20}
  cgroup -> collector {style.stroke-dash: 4}
  nvme -> collector {style.stroke-dash: 4}
}
prom: "Prometheus\nCorrelated observations, not causal proof" {class: evidence}
node.collector -> prom: scrape {style.stroke-dash: 4; style.font-size: 20}
