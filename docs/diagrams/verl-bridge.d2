# Title: VERL bridge outputs
# Description: One completed step creates a latest metric snapshot and a historical step event with different backend paths.
...@_style

direction: down
record: "Completed VERL record\nstep=7 / timing_s/gen=2.4\nperf/time_per_step=8.0" {class: source}
bridge: "VERL bridge" {class: process}
current: Latest state {
  snapshot: "Latest snapshot\nrollout=2.4s / step_time=8.0s" {class: process}
  metrics: "application.prom\nNode Exporter > Prometheus" {class: process}
  view: "Agent RL metric panels" {class: evidence}
  snapshot -> metrics -> view
}
history: Completed step history {
  step_events: "verl-steps.jsonl\nStep identity + time provenance" {class: process}
  loki: "Optional Alloy > Loki" {class: optional}
  view: "Run Overview / Timeline" {class: evidence}
  step_events -> loki -> view
}
record -> bridge
bridge -> current.snapshot
bridge -> history.step_events
