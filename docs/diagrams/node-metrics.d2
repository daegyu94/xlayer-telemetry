# Title: Node metric collection
# Description: Application textfiles and GPU textfiles are exposed with host metrics by Node Exporter and scraped by Prometheus.
...@_style

direction: down
node: Workload / resource node {
  textfiles: Textfile inputs {
    grid-columns: 1
    grid-gap: 24
    app: "Application snapshot\nBridge / SDK\napplication.prom" {class: source}
    gpu: "GPU sampler\ngpu.prom" {class: source}
  }
  host: "Native host collectors\nCPU / memory\nNetwork / disk" {class: source}
  exporter: "Node Exporter :19100" {class: process}
  textfiles -> exporter
  host -> exporter
}
prometheus: "Prometheus\nMonitoring host" {class: process}
grafana: "Grafana metric dashboards" {class: evidence}
node.exporter -> prometheus: scrape {style.font-size: 18}
prometheus -> grafana: query {style.font-size: 18}
