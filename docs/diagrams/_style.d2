# Shared compact documentation style; pinned D2/ELK render owns layout.
***.style.font-size: 18
***.style.stroke-width: 1
***: {
  &leaf: false
  style: {fill: "#f8fafc"; stroke: "#cbd5e1"}
}
# Compact ELK spacing is pinned in render_diagrams.py.
classes: {
  source: {style: {font-size: 18; fill: "#ffffff"; stroke: "#94a3b8"; border-radius: 6}}
  process: {style: {font-size: 18; fill: "#f8fafc"; stroke: "#94a3b8"; border-radius: 6}}
  evidence: {style: {font-size: 18; fill: "#eef2ff"; stroke: "#6366f1"; border-radius: 6}}
  optional: {style: {font-size: 18; fill: "#f8fafc"; stroke: "#94a3b8"; stroke-dash: 4; border-radius: 6}}
}
