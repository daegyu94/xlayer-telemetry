# Shared documentation style; generation pins D2 and layout in render_diagrams.py.
**.style.font-size: 20
**.style.stroke-width: 2
classes: {
  source: {style: {font-size: 20; fill: "#eff6ff"; stroke: "#38669a"; border-radius: 8}}
  process: {style: {font-size: 20; fill: "#edf8f5"; stroke: "#34776d"; border-radius: 8}}
  evidence: {style: {font-size: 20; fill: "#fff5e7"; stroke: "#93682d"; border-radius: 8}}
  optional: {style: {font-size: 20; fill: "#f4f2f8"; stroke: "#766889"; stroke-dash: 4; border-radius: 8}}
}
