# Title: XLayer Telemetry system overview
# Description: Configured workload and shared resources feed context and comparable evidence; the arrows describe information flow, not execution ownership or causality.
...@_style

direction: right
sources: "Workload + resources\nVERL / native / host" {class: source}
collect: "Collect\nquery sources" {class: process}
context: "Correlate\nrun / scope" {class: process}
evidence: "Diagnose\nbaseline / evidence" {class: evidence}
inspect: "Deep Dive\nexisting tools" {class: optional}
sources -> collect -> context -> evidence -> inspect {style.stroke: "#6366f1"; style.font-size: 18}
