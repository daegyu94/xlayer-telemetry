# Title: Collect, correlate, diagnose
# Description: Configured sources become context, comparable evidence and targeted deep dives; this is an information flow, not a causal execution trace.
...@_style

direction: right
collect: "Collect" {class: process}
context: "Correlate" {class: process}
candidate: "Diagnose" {class: evidence}
detail: "Deep Dive" {class: optional}
collect -> context -> candidate -> detail {style.stroke: "#6366f1"}
