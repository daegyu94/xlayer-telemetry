  "fixes": [
    {
      "priority": "P1",
      "issue": "Partial backend results were finalized before missing queries arrived",
      "change": "Retry attempted missing sources within the existing deadline"
    },
    {
      "priority": "P1",
      "issue": "Split UTF-8 or malformed encoding could stop the VERL bridge",
      "change": "Read bytes through the newline boundary; decode completed records and skip malformed lines"
    },
    {
      "priority": "P1",
      "issue": "Sandbox sampler cleanup could unlink outside the textfile directory before validating the basename",
      "change": "Validate output basename and finite interval before cleanup"
    },
    {
      "priority": "P1",
      "issue": "Missing shutdown diagnostics config replaced the workload exit code",
      "change": "Capture settle policy before starting the workload"
    },
    {
      "priority": "P1",
      "issue": "ClickHouse quoted numeric cells were ignored; malformed/null latency rows could terminate analysis",
      "change": "Validate and normalize external numeric fields, retain missing latency as unavailable"
    },
    {
      "priority": "P1",
      "issue": "Concurrent wrappers could both initialize the same run directory",
      "change": "Hold a per-output flock across the check-and-create sequence and run lifecycle"
    },
    {
      "priority": "P2",
      "issue": "Repository CI covered documentation only",
      "change": "Add CPU regression and syntax workflow for Ubuntu 22.04/Python 3.10 and Ubuntu 24.04/Python 3.12"
    }
  ],
