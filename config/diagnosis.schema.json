{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/daegyu94/xlayer-telemetry/blob/main/config/diagnosis.schema.json",
  "title": "XLayer bottleneck diagnosis",
  "description": "Rule diagnosis report with inspectable evidence. Additive fields preserve legacy output compatibility; this is not the separate optional LLM response schema. Correlation is not attribution.",
  "type": "object",
  "required": ["schema_version", "record_type", "run_id", "analysis_window", "verdict", "findings", "evidence", "missing_sources", "diagnosis_schema_version", "symptom", "comparison", "candidates"],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "bottleneck_diagnosis"},
    "diagnosis_schema_version": {"const": 1},
    "run_id": {"type": "string"},
    "data_origin": {"enum": ["observed", "synthetic"]},
    "diagnosis_method": {"const": "rule"},
    "sampling_quality": {"type": "object"},
    "rollout_replicas": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["id", "instance", "endpoint_node", "nodes", "status", "clock_status", "entities", "signals", "candidates"],
        "properties": {
          "id": {"type": "string"}, "instance": {"type": "string"},
          "endpoint_node": {"type": "string"},
          "nodes": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string"}},
          "status": {"enum": ["observed", "partial_evidence", "clock_unverified", "missing", "identity_limit"]},
          "clock_status": {"enum": ["aligned", "unknown"]},
          "resource_attribution": {"const": "not_established"},
          "run_relation": {"const": "configured"},
          "entities": {"type": "array", "maxItems": 8},
          "signals": {"type": "object"}, "candidates": {"type": "array"}
        }
      }
    },
    "query_execution": {
      "type": "object",
      "required": ["budget_seconds", "elapsed_seconds", "budget_exhausted", "sources"],
      "properties": {
        "budget_seconds": {"type": "number", "exclusiveMinimum": 0},
        "elapsed_seconds": {"type": "number", "minimum": 0},
        "budget_exhausted": {"type": "boolean"},
        "sources": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["attempted", "failed", "skipped", "unavailable"],
            "properties": {
              "attempted": {"type": "integer", "minimum": 0},
              "failed": {"type": "integer", "minimum": 0},
              "skipped": {"type": "integer", "minimum": 0},
              "unavailable": {"type": "boolean"}
            }
          }
        }
      }
    },
    "sandbox_device_mapping": {"type": ["object", "null"]},
    "analysis_status": {"enum": ["provisional", "final"]},
    "revision": {"type": "integer", "minimum": 1},
    "first_attempt_at": {"type": "number"},
    "retry_at": {"type": ["number", "null"]},
    "analysis_window": {"$ref": "#/$defs/interval"},
    "clock_quality": {
      "type": "object",
      "required": ["status", "nodes"],
      "properties": {
        "status": {"enum": ["aligned", "unsafe", "unknown", "unchecked"]},
        "nodes": {"type": "object"},
        "baseline": {"type": "object"}
      }
    },
    "verdict": {"enum": ["bottleneck_suspected", "no_anomaly_observed", "insufficient_data"]},
    "findings": {"type": "array"},
    "evidence": {"type": "object"},
    "missing_sources": {"type": "array", "items": {"type": "string"}},
    "symptom": {"type": "object"},
    "comparison": {
      "type": "object",
      "required": ["current_interval", "baseline_interval", "selection", "signals"],
      "properties": {
        "current_interval": {"$ref": "#/$defs/interval"},
        "baseline_interval": {"anyOf": [{"$ref": "#/$defs/interval"}, {"type": "null"}]},
        "baseline_record_id": {"type": ["string", "null"]},
        "workload_comparability": {"enum": ["matched_configured_fields", "unverified", "unavailable"]},
        "selection": {"enum": ["same_run_same_worker_nearest_prior_median", "unavailable"]},
        "signals": {"type": "array", "items": {"type": "object"}}
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "component", "summary", "state", "evidence", "counter_evidence", "missing_evidence", "observation_scope", "related_nodes", "related_devices", "related_spans"],
        "properties": {
          "id": {"type": "string"},
          "component": {"type": "string"},
          "summary": {"type": "string"},
          "state": {"enum": ["weak_signal", "supporting_signal", "strong_signal"]},
          "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
          "counter_evidence": {"type": "array", "items": {"$ref": "#/$defs/counter_evidence"}},
          "missing_evidence": {"type": "array", "items": {"type": "string"}},
          "observation_scope": {"$ref": "#/$defs/observation_scope"},
          "resource_attribution": {"enum": ["not_established"]},
          "run_relation": {"enum": ["configured", "shared_unverified", "unlinked"]},
          "signal_strength": {"enum": ["weak_signal", "supporting_signal", "strong_signal"]},
          "related_nodes": {"type": "array", "items": {"type": "string"}},
          "related_devices": {"type": "array", "items": {"type": "string"}},
          "related_spans": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  },
  "$defs": {
    "interval": {
      "type": "object",
      "description": "Workload interval with timestamp provenance. Unknown/replayed boundaries may be null or unavailable and cannot anchor external resource correlation.",
      "properties": {
        "start": {"type": ["number", "null"]},
        "end": {"type": ["number", "null"]},
        "accuracy": {"type": "string"},
        "source": {"type": "string"}
      }
    },
    "counter_evidence": {
      "type": "object",
      "required": ["signal", "value", "observation_scope"],
      "properties": {
        "signal": {"type": "string"},
        "value": {"type": "number"},
        "observation_scope": {"$ref": "#/$defs/observation_scope"},
        "labels": {"type": "object"}
      }
    },
    "observation_scope": {
      "enum": ["application", "process", "worker", "cgroup", "device", "node", "network-interface", "service", "shared-service", "cluster", "mixed", "unknown"]
    },
    "evidence": {
      "type": "object",
      "required": ["signal", "value", "observation_scope", "source", "boundary_accuracy"],
      "properties": {
        "signal": {"type": "string"},
        "value": {"type": "number"},
        "baseline": {"type": ["number", "null"]},
        "observation_scope": {"$ref": "#/$defs/observation_scope"},
        "source": {"type": "string"},
        "labels": {"type": "object"},
        "query": {"type": ["string", "null"]},
        "window": {"anyOf": [{"$ref": "#/$defs/interval"}, {"type": "null"}]},
        "boundary_accuracy": {"type": "string"},
        "sampling_quality": {"type": ["object", "null"]}
      }
    }
  }
}
