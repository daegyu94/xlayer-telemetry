{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "XLayer Telemetry",
  "id": "xlayer-telemetry-app",
  "info": {
    "description": "Classic and Workspace views over shared Agent RL observability, infrastructure and diagnosis contracts",
    "author": {
      "name": "XLayer Telemetry contributors"
    },
    "keywords": [
      "agent-rl",
      "observability",
      "scenes"
    ],
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      {
        "name": "Project",
        "url": "https://github.com/daegyu94/xlayer-telemetry"
      }
    ],
    "version": "0.1.0",
    "updated": "2026-10-09"
  },
  "dependencies": {
    "grafanaDependency": ">=12.1.0",
    "plugins": []
  },
  "includes": [
    {
      "type": "page",
      "name": "Overview",
      "path": "/a/xlayer-telemetry-app/overview",
      "addToNav": true,
      "defaultNav": true,
      "role": "Viewer"
    },
    {
      "type": "page",
      "name": "Analyze",
      "path": "/a/xlayer-telemetry-app/analyze",
      "addToNav": false,
      "role": "Viewer"
    },
    {
