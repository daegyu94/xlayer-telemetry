{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "XLayer Telemetry",
  "id": "xlayer-telemetry-app",
  "info": {
    "description": "Agent RL investigation over existing XLayer dashboards and datasource contracts",
    "author": {
      "name": "XLayer Telemetry contributors"
    },
    "keywords": [
      "agent-rl",
      "observability",
      "scenes"
    ],
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      {
        "name": "Project",
        "url": "https://github.com/daegyu94/xlayer-telemetry"
      }
    ],
    "version": "0.1.0",
    "updated": "2026-10-07"
  },
  "dependencies": {
    "grafanaDependency": ">=12.1.0",
    "plugins": []
  },
  "includes": [
    {
      "type": "page",
      "name": "Overview",
      "path": "/a/xlayer-telemetry-app/overview",
      "addToNav": true,
      "defaultNav": true,
      "role": "Viewer"
    },
    {
      "type": "page",
      "name": "Analyze",
      "path": "/a/xlayer-telemetry-app/analyze",
      "addToNav": false,
      "role": "Viewer"
    },
    {
      "type": "page",
      "name": "Investigate",
      "path": "/a/xlayer-telemetry-app/investigate",
      "addToNav": false,
      "role": "Viewer"
    },
    {
      "type": "page",
      "name": "Timeline",
      "path": "/a/xlayer-telemetry-app/timeline",
      "addToNav": false,
      "role": "Viewer"
    },
    {
      "type": "page",
      "name": "Deep Dive",
      "path": "/a/xlayer-telemetry-app/deep-dive",
      "addToNav": false,
      "role": "Viewer"
    }
  ]
}
